datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  PERSONNEL
  ADMIN
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String?
  role          Role            @default(CITIZEN)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  reports       Report[]        @relation("CitizenReports")
  statusChanges StatusHistory[] @relation("StaffChanges")

  @@map("users")
}

model Report {
  id            String          @id @default(uuid())
  reference     String          @unique
  category      String
  description   String
  location      String
  status        ReportStatus    @default(SUBMITTED)
  citizenId     String
  citizen       User            @relation("CitizenReports", fields: [citizenId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  statusHistory StatusHistory[]

  @@index([status])
  @@index([category])
  @@index([citizenId])
  @@map("reports")
}

model StatusHistory {
  id          String       @id @default(uuid())
  reportId    String
  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus  ReportStatus
  toStatus    ReportStatus
  changedById String
  changedBy   User         @relation("StaffChanges", fields: [changedById], references: [id])
  comment     String?
  createdAt   DateTime     @default(now())

  @@map("status_history")
}