# Runtime Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection URL (PostgreSQL 18.x)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicconnect_db?schema=public"

# Frontend Allowed Origin (for CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# Cryptographic Signing Secret (Minimum 32 characters)
AUTH_SECRET="civicconnect-dev-secret-key-must-be-at-least-32-chars-long"

# Log Level
LOG_LEVEL="info"