# Runtime Mode
NODE_ENV=development
PORT=3000

# PostgreSQL 18 Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicconnect_db?schema=public"

# Frontend Allowed Origin (CORS allow-list)
FRONTEND_ORIGIN="http://localhost:5173"

# Cryptographic Token Secret (Minimum 32 characters)
AUTH_SECRET="civicconnect-dev-secret-key-must-be-at-least-32-chars-long"

# Logging
LOG_LEVEL="info"