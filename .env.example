# Copy to .env and fill in real values. Never commit .env (see R-007 / FE-06).
PORT=3000
# PostgreSQL connection string (local docker-compose, Neon, Supabase, ...)
DATABASE_URL="postgresql://civic:civic@localhost:5432/civicconnect?schema=public"
# Long random string used to sign login tokens
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# true = run without a database using the in-memory repositories (demo/dev only)
USE_MEMORY_REPO=false
